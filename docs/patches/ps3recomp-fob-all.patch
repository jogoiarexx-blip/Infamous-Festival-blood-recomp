+static int64_t sys_spu_thread_bind_queue(ppu_context* ctx)
+{
+    uint32_t tid = LV2_ARG_U32(ctx, 0), qid = LV2_ARG_U32(ctx, 1), spuq = LV2_ARG_U32(ctx, 2);
+    int slot = -1;
+    for (int i = 0; i < 64; i++) {
+        if (s_spuq_bind[i].qid && s_spuq_bind[i].tid == tid && s_spuq_bind[i].spuq == spuq) { slot = i; break; }
+        if (slot < 0 && !s_spuq_bind[i].qid) slot = i;
+    }
