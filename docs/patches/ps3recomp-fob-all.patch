+uint32_t spu_thread_bound_queue(uint32_t tid, uint32_t spuq)
+{
+    for (int i = 0; i < 64; i++)
+        if (s_spuq_bind[i].qid && s_spuq_bind[i].tid == tid && s_spuq_bind[i].spuq == spuq)
