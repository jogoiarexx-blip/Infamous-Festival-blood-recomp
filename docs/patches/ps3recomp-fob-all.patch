+/* Host-side blocking receive for an SPU thread's sys_spu_thread_receive_event
+ * (stop 0x110): waits on the queue until an event arrives, a destroy/cancel, or
+ * *stop becomes non-zero. Returns 0 with data1..3 in out[], else -1. */
+int sys_event_queue_receive_host(uint32_t queue_id, uint64_t out[3], volatile int* stop)
+{
+#ifdef _WIN32
+    if (queue_id == 0 || queue_id > SYS_EVENT_QUEUE_MAX) return -1;
+    sys_event_queue_info* q = &g_sys_event_queues[queue_id - 1];
+    if (!q->active) return -1;
+    EnterCriticalSection(&q->lock);
+    if (!q->active) { LeaveCriticalSection(&q->lock); return -1; }
+    q->waiters++;
+    while (q->count == 0 && q->active && !q->cancelled) {
+        SleepConditionVariableCS(&q->not_empty, &q->lock, 50);
+        if (stop && *stop) break;
+    }
+    if (q->count == 0) { q->waiters--; LeaveCriticalSection(&q->lock); return -1; }
+    sys_event_t evt = q->buffer[q->head];
+    q->head = (q->head + 1) % q->capacity;
+    q->count--;
+    q->waiters--;
+    LeaveCriticalSection(&q->lock);
+    out[0] = evt.data1; out[1] = evt.data2; out[2] = evt.data3;
+    return 0;
+#else
+    (void)queue_id; (void)out; (void)stop;
+    return -1;
+#endif
+}
