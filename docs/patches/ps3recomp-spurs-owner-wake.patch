+/* Last (taskset, task) that parked on each wait-object line. An LFQueue whose
+ * owner is a SPURS cannot name its consumer's taskset, and a push that lands
+ * while the consumer is busy (not parked) must still latch a signal for it. */
+#define SPU_OBJ_OWNER_MAX 32
+static struct { volatile uint32_t line; volatile uint32_t taskset; volatile uint32_t task; } s_obj_owner[SPU_OBJ_OWNER_MAX];
+
+static void spu_obj_owner_note(uint32_t wait_obj, uint32_t taskset_ea, uint32_t taskId)
+{
+    if (!wait_obj) return;
+    const uint32_t line = wait_obj & ~0x7Fu;
+    int free_i = -1;
+    for (int i = 0; i < SPU_OBJ_OWNER_MAX; i++) {
+        if (s_obj_owner[i].line == line) { s_obj_owner[i].taskset = taskset_ea; s_obj_owner[i].task = taskId; return; }
+        if (free_i < 0 && !s_obj_owner[i].line) free_i = i;
+    }
+    if (free_i >= 0) {
+        s_obj_owner[free_i].taskset = taskset_ea; s_obj_owner[free_i].task = taskId;
+        s_obj_owner[free_i].line = line;
+    }
+}
