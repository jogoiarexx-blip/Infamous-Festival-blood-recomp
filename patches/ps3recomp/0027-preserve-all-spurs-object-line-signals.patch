+
+static void spu_obj_owner_drop(uint32_t taskset_ea, uint32_t taskId)
+{
+    spu_obj_owner_lock();
+    for (size_t i = 0; i < s_obj_owner_count; ++i) {
+        if (s_obj_owner[i].taskset != taskset_ea || s_obj_owner[i].task != taskId) continue;
+        s_obj_owner[i] = s_obj_owner[--s_obj_owner_count];
