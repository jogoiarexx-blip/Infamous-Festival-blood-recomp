+        if (owner->taskset == taskset_ea && owner->task == taskId) {
+            if (owner->line != line) { owner->line = line; owner->pend = 0; }
+            spu_obj_owner_unlock();
+            return;
+        }
+    }
+    if (s_obj_owner_count == s_obj_owner_cap) {
