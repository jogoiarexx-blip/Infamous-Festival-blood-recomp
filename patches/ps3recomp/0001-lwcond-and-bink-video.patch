diff --git a/libs/video/rsx_vertex_data.h b/libs/video/rsx_vertex_data.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_vertex_data.h
@@ -0,0 +1,77 @@
+#ifndef PS3RECOMP_RSX_VERTEX_DATA_H
+#define PS3RECOMP_RSX_VERTEX_DATA_H
+
+#include "rsx_commands.h"
+#include <string.h>
+
+typedef struct {
+    u32 attribute;
+    u32 lanes;
+    float value[4];
+    int complete;
+} rsx_vertex_data_write;
+
+/* Decode a write to the current vertex attributes. Completing attribute
+ * zero emits a vertex when a primitive is open. */
+static inline int rsx_decode_vertex_data(u32 method, u32 word, rsx_vertex_data_write* out)
+{
+    u32 base;
+    u32 stride;
+    u32 components;
+    if (method >= 0x1880 && method < 0x1900) {
+        base = 0x1880; stride = 8; components = 2;
+    } else if (method >= 0x1500 && method < 0x1600) {
+        base = 0x1500; stride = 16; components = 3;
+    } else if (method >= 0x1C00 && method < 0x1D00) {
+        base = 0x1C00; stride = 16; components = 4;
+    } else if (method >= 0x1E40 && method < 0x1E80) {
+        base = 0x1E40; stride = 4; components = 1;
+    } else if (method >= 0x1900 && method < 0x1940) {
+        out->attribute = (method - 0x1900) / 4;
+        out->lanes = 0xF;
+        out->value[0] = (float)(int16_t)word;
+        out->value[1] = (float)(int16_t)(word >> 16);
+        out->value[2] = 0.0f;
+        out->value[3] = 1.0f;
+        out->complete = 1;
+        return 1;
+    } else if (method >= 0x1940 && method < 0x1980) {
+        out->attribute = (method - 0x1940) / 4;
+        out->lanes = 0xF;
+        for (u32 lane = 0; lane < 4; lane++)
+            out->value[lane] = (float)((word >> (lane * 8)) & 0xFFu) / 255.0f;
+        out->complete = 1;
+        return 1;
+    } else if ((method >= 0x1980 && method < 0x1A00) ||
+               (method >= 0x0A80 && method < 0x0B00)) {
+        const u32 packed_base = method >= 0x1980 ? 0x1980u : 0x0A80u;
+        const float scale = method >= 0x1980 ? 1.0f : 1.0f / 32767.0f;
+        const u32 lane = ((method - packed_base) & 4u) / 2u;
+        out->attribute = (method - packed_base) / 8;
+        out->lanes = 3u << lane;
+        out->value[lane] = (float)(int16_t)word * scale;
+        out->value[lane + 1] = (float)(int16_t)(word >> 16) * scale;
+        out->complete = lane == 2;
+        return 1;
+    } else {
+        return 0;
+    }
+
+    const u32 lane = ((method - base) % stride) / 4;
+    out->attribute = (method - base) / stride;
+    out->lanes = 0;
+    out->complete = lane + 1 == components;
+    if (lane < components) {
+        memcpy(&out->value[lane], &word, sizeof(word));
+        out->lanes = 1u << lane;
+    }
+    if (lane == 0) {
+        for (u32 extra = components; extra < 4; extra++) {
+            out->value[extra] = extra == 3 ? 1.0f : 0.0f;
+            out->lanes |= 1u << extra;
+        }
+    }
+    return 1;
+}
+
+#endif
