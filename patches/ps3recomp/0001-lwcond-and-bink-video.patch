+static void d3d12_draw_immediate(void* ud, const rsx_state* state, u32 primitive,
+                                 const float (*vertices)[RSX_MAX_VERTEX_ATTRIBS][4], u32 count)
+{
+    if (primitive < RSX_PRIMITIVE_TRIANGLES || primitive > RSX_PRIMITIVE_POLYGON ||
+        state->vp_ucode_bytes < 16 || !s_d3d.vp_vb_mapped || !s_d3d.vp_root_sig)
+        return;
+
+    const rsx_state* previous_state = s_d3d.current_rsx_state;
+    s_d3d.current_rsx_state = state;
+    s_immediate_vertices = vertices;
+    s_d3d.merge_prev_draw = 0;
+    const u32 previous_draw_count = s_d3d.draw_count;
+    d3d12_draw_arrays(ud, primitive, 0, count);
+    s_d3d.merge_prev_draw = 0;
+    s_immediate_vertices = NULL;
+    s_d3d.current_rsx_state = previous_state;
+
+    static int logged;
+    if (s_d3d.draw_count != previous_draw_count && PS3_LOG_FIRST(logged, 8))
+        fprintf(stderr, "[D3D12] immediate draw prim=%u vertices=%u fp=0x%X tex0=0x%X\n",
+                primitive, count, state->shader_program, state->textures[0].offset);
+}
