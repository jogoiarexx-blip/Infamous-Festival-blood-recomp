diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 16db1de..8f6ae4f 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -3680,3 +3680,94 @@ s32 cellSpursLFQueueAttachLv2EventQueue(u64 queue_ea)
     if (PS3_LOG_FIRST(_n, 8)) printf("[cellSpurs] LFQueueAttachLv2EventQueue(q=0x%08X)\n", (u32)queue_ea);
     return CELL_OK;
 }
+
+/* The queue is shared with a recompiled SPU consumer. Its producer indices
+ * live at +0x08; the consumer owns +0x04 and must advance it itself. */
+s32 _cellSpursLFQueuePushBody(u64 queue_ea, const void* buffer, u32 isBlocking)
+{
+    if (!queue_ea || !buffer)
+        return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+
+    const uint32_t q = (uint32_t)queue_ea;
+    if (!spurs_guest_range_valid(q, 128))
+        return CELL_SPURS_TASK_ERROR_INVAL;
+
+    const uint32_t size = vm_read32(q + 0x10);
+    const uint32_t depth = vm_read32(q + 0x14);
+    const uint32_t data_ea = (uint32_t)vm_read64(q + 0x18);
+    const uint32_t owner_ea = (uint32_t)vm_read64(q + 0x70);
+    const uint32_t modulus = vm_read32(q + 0x0C);
+    const uintptr_t source = (uintptr_t)buffer;
+    if (!size || !depth || !modulus || !data_ea || modulus != depth ||
+        modulus > INT16_MAX ||
+        (u64)size * depth > UINT32_MAX ||
+        !spurs_guest_range_valid(data_ea, size * depth) ||
+        (source <= UINT32_MAX && !spurs_guest_range_valid((uint32_t)source, size)))
+        return CELL_SPURS_TASK_ERROR_INVAL;
+
+    uint32_t current;
+    int spins = 0;
+    for (;;)
+    {
+        const int32_t pop = (int16_t)(uint16_t)vm_read32(q + 0x04);
+        const int32_t tail = (int16_t)vm_read16(q + 0x08);
+        const int32_t consumed = pop < 0 ? ~pop : pop;
+        current = (uint32_t)(tail < 0 ? ~tail : tail);
+        const uint32_t occupancy = current >= (uint32_t)consumed
+            ? current - (uint32_t)consumed
+            : current + 2u * modulus - (uint32_t)consumed;
+        if (occupancy < depth)
+            break;
+        if (!isBlocking)
+            return CELL_SPURS_TASK_ERROR_BUSY;
+        if (++spins >= 200)
+        {
+#ifdef _WIN32
+            Sleep(1);
+#else
+            usleep(1000);
+#endif
+            spins = 0;
+        }
+    }
+
+    const uint32_t slot = current % modulus;
+    const void* src = source <= UINT32_MAX
+        ? (const void*)(vm_base + (uint32_t)source) : buffer;
+    memcpy(vm_base + data_ea + (size_t)slot * size, src, size);
+
+    const uint32_t next = (current + 1u) % (2u * modulus);
+    /* Publish the two producer halfwords in one 32-bit guest store, so an SPU
+     * snapshot cannot see an index from each side of the update. */
+    vm_write32(q + 0x08, (next << 16) | next);
+
+    uint8_t* const header = vm_base + q;
+    const uint32_t waiters = header[0x20];
+    if (waiters && waiters <= 3 && owner_ea && !(owner_ea & 1u))
+    {
+        const uint32_t task = header[0x21];
+        header[0x21] = header[0x22];
+        header[0x22] = header[0x23];
+        header[0x23] = 0;
+        header[0x20] = (uint8_t)(waiters - 1);
+        extern void spu_taskset_signal_task(uint32_t taskset_ea, uint32_t taskId);
+        spu_taskset_signal_task(owner_ea, task);
+    }
+
+    /* SPURS-owned queues store spurs|1, not a taskset EA. The consumer is
+     * found by its registered wait-object line; count the wake per push. */
+    extern int spu_taskset_signal_parked_line(uint32_t obj_ea);
+    spu_taskset_signal_parked_line(q);
+    if (owner_ea && !(owner_ea & 1u))
+    {
+        extern void spu_taskset_signal_task(uint32_t taskset_ea, uint32_t taskId);
+        spu_taskset_signal_task(owner_ea, 0);
+        spu_taskset_signal_task(owner_ea, 1);
+    }
+
+    static int logged = 0;
+    if (PS3_LOG_FIRST(logged, 20))
+        printf("[cellSpurs] _cellSpursLFQueuePushBody q=0x%08X slot=%u size=%u depth=%u\n",
+               q, slot, size, depth);
+    return CELL_OK;
+}
diff --git a/libs/spurs/cellSpurs.h b/libs/spurs/cellSpurs.h
index adfbf89..84e6350 100644
--- a/libs/spurs/cellSpurs.h
+++ b/libs/spurs/cellSpurs.h
@@ -319,6 +319,7 @@ s32 cellSpursQueueSize(u64 queue_ea, u64 size_ea);
