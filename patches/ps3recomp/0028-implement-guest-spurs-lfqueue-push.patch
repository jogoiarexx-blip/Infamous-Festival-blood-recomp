                                 u32 size, u32 depth, u32 direction);
 s32 cellSpursLFQueueAttachLv2EventQueue(u64 queue_ea);
+s32 _cellSpursLFQueuePushBody(u64 queue_ea, const void* buffer, u32 isBlocking);
 
 s32 cellSpursEventFlagSet(CellSpursEventFlag* eventFlag, u16 bits);
 s32 cellSpursEventFlagWait(CellSpursEventFlag* eventFlag, u16* bits,
diff --git a/tests/test_spurs_queue_size.c b/tests/test_spurs_queue_size.c
index 4ef109b..b250ef5 100644
--- a/tests/test_spurs_queue_size.c
+++ b/tests/test_spurs_queue_size.c
@@ -66,7 +66,31 @@ int main(void)
     assert(cellSpursQueueSize(Q, OUT) == (s32)CELL_SPURS_TASK_ERROR_INVAL);
     assert(vm_read32(OUT) == 0x12345678u);
 
+    /* The LFQueue is a separate 128-byte guest structure consumed by SPU
+     * code. A producer must write the payload and both push halfwords while
+     * leaving the consumer's pop word untouched. */
+    const uint32_t lfq = 0x3000, data = 0x4000, src = 0x5000;
+    memset(vm_base + lfq, 0, 128);
+    vm_write32(lfq + 0x0C, 2);
+    vm_write32(lfq + 0x10, 16);
+    vm_write32(lfq + 0x14, 2);
+    vm_write64(lfq + 0x18, data);
+    for (uint32_t i = 0; i < 16; i++) vm_base[src + i] = (uint8_t)(0xA0 + i);
+    assert(_cellSpursLFQueuePushBody(lfq, (const void*)(uintptr_t)src, 0) == CELL_OK);
+    assert(memcmp(vm_base + data, vm_base + src, 16) == 0);
+    assert(vm_read32(lfq + 0x08) == 0x00010001u);
+    assert(vm_read32(lfq + 0x04) == 0);
+    assert(_cellSpursLFQueuePushBody(lfq, (const void*)(uintptr_t)src, 0) == CELL_OK);
+    assert(vm_read32(lfq + 0x08) == 0x00020002u);
+    assert(_cellSpursLFQueuePushBody(lfq, (const void*)(uintptr_t)src, 0) == (s32)CELL_SPURS_TASK_ERROR_BUSY);
+    vm_write32(lfq + 0x04, 1);  /* SPU consumed one entry */
+    assert(_cellSpursLFQueuePushBody(lfq, (const void*)(uintptr_t)src, 0) == CELL_OK);
+    assert(vm_read32(lfq + 0x08) == 0x00030003u);
+    assert(_cellSpursLFQueuePushBody(lfq, 0, 0) == (s32)CELL_SPURS_TASK_ERROR_NULL_POINTER);
+    vm_write32(lfq + 0x14, 0);  /* invalid depth must not copy */
+    assert(_cellSpursLFQueuePushBody(lfq, (const void*)(uintptr_t)src, 0) == (s32)CELL_SPURS_TASK_ERROR_INVAL);
+
     free(vm_base);
-    puts("PASS: cellSpursQueueSize occupancy, wrap, normalised indices, NULL/alignment/uninitialised errors");
+    puts("PASS: SPURS queue size and LFQueue guest producer indices, payload, full and invalid cases");
     return 0;
 }
