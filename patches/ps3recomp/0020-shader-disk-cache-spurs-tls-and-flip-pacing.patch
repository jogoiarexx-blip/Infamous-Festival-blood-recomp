+static ID3DBlob* d3d12_compile_shader_cached(const char* src, size_t len, const char* name,
+                                             const char* entry, const char* target, ID3DBlob** out_err)
+{
+    if (out_err) *out_err = NULL;
+    if (!src || len == 0) return NULL;
+
+    /* Version the key and the file format. Include all compilation inputs. */
+    uint64_t h = 14695981039346656037ULL;
+    static const char cache_version[] = "rsx-d3dcompile-cache-v1";
+    for (const char* p = cache_version; *p; p++) {
+        h ^= (uint8_t)*p;
+        h *= 1099511628211ULL;
+    }
+    for (const char* p = target; *p; p++) {
+        h ^= (uint8_t)*p;
+        h *= 1099511628211ULL;
+    }
+    for (const char* p = entry; *p; p++) {
+        h ^= (uint8_t)*p;
+        h *= 1099511628211ULL;
+    }
+    for (size_t i = 0; i < len; i++) {
+        h ^= (uint8_t)src[i];
+        h *= 1099511628211ULL;
+    }
+
+    const char* cdir = getenv("RSX_SHADER_CACHE_DIR");
+    if (!cdir || !*cdir) cdir = "shader_cache";
+    CreateDirectoryA(cdir, NULL); /* Safe for concurrent callers. */
+
+    char filepath[MAX_PATH] = {0};
+    int pathlen = snprintf(filepath, sizeof(filepath), "%s/%s_%016llX.bin",
+                           cdir, target, (unsigned long long)h);
+    if (pathlen < 0 || pathlen >= (int)sizeof(filepath) - 40) filepath[0] = 0;
+
+    struct shader_cache_header {
+        uint32_t magic, version;
+        uint64_t key, bytecode_hash;
+        uint32_t bytecode_size, reserved;
+    } header;
+
+    /* Try loading cached bytecode from disk */
+    HANDLE hFile = filepath[0] ? CreateFileA(filepath, GENERIC_READ,
+        FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
+        : INVALID_HANDLE_VALUE;
+    if (hFile != INVALID_HANDLE_VALUE) {
+        DWORD sz = GetFileSize(hFile, NULL);
+        DWORD read = 0;
+        if (sz > sizeof(header) && sz < 10 * 1024 * 1024 &&
+            ReadFile(hFile, &header, sizeof(header), &read, NULL) &&
+            read == sizeof(header) && header.magic == 0x43585352u &&
+            header.version == 1 && header.key == h && header.reserved == 0 &&
+            header.bytecode_size == sz - sizeof(header)) {
+            ID3DBlob* blob = NULL;
+            if (SUCCEEDED(D3DCreateBlob(header.bytecode_size, &blob)) && blob) {
+                void* bytes = blob->lpVtbl->GetBufferPointer(blob);
+                if (ReadFile(hFile, bytes, header.bytecode_size, &read, NULL) &&
+                    read == header.bytecode_size) {
+                    uint64_t digest = 14695981039346656037ULL;
+                    for (DWORD i = 0; i < header.bytecode_size; ++i) {
+                        digest ^= ((const uint8_t*)bytes)[i];
+                        digest *= 1099511628211ULL;
+                    }
+                    ID3D11ShaderReflection* reflection = NULL;
+                    HRESULT valid = digest == header.bytecode_hash
+                        ? D3DReflect(bytes, header.bytecode_size,
+                                     &IID_ID3D11ShaderReflection, (void**)&reflection)
+                        : E_FAIL;
+                    if (reflection) reflection->lpVtbl->Release(reflection);
+                    if (SUCCEEDED(valid)) {
+                        CloseHandle(hFile);
+                        return blob;
+                    }
+                }
+                blob->lpVtbl->Release(blob);
+            }
+        }
+        CloseHandle(hFile);
+    }
+
+    /* Fallback: compile with D3DCompile */
+    ID3DBlob* blob = NULL;
+    ID3DBlob* err = NULL;
+    HRESULT hr = D3DCompile(src, len, name, NULL, NULL, entry, target, 0, 0, &blob, &err);
+    if (out_err) *out_err = err;
+    else if (err) err->lpVtbl->Release(err);
+
+    if (SUCCEEDED(hr) && blob) {
+        size_t bytes = blob->lpVtbl->GetBufferSize(blob);
+        if (filepath[0] && bytes > 0 && bytes < 10 * 1024 * 1024) {
+            header.magic = 0x43585352u; /* RSXC */
+            header.version = 1;
