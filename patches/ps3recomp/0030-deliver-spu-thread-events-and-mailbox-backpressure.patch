+/* sys_spu_thread_bind_queue(thread, equeue, spuq_num): remember which event queue an SPU
+ * thread reads for a given SPU-side queue number, so its stop 0x110
+ * (sys_spu_thread_receive_event) can find it. */
+static struct { uint32_t tid, spuq, qid; } s_spuq_bind[64];
+static SRWLOCK s_spuq_bind_lock = SRWLOCK_INIT;
+uint32_t spu_thread_bound_queue(uint32_t tid, uint32_t spuq)
+{
+    uint32_t qid = 0;
+    AcquireSRWLockShared(&s_spuq_bind_lock);
+    for (int i = 0; i < 64; i++)
+        if (s_spuq_bind[i].qid && s_spuq_bind[i].tid == tid && s_spuq_bind[i].spuq == spuq) {
+            qid = s_spuq_bind[i].qid;
+            break;
+        }
+    ReleaseSRWLockShared(&s_spuq_bind_lock);
+    return qid;
+}
+
+static void spu_thread_unbind_all(uint32_t tid)
+{
+    AcquireSRWLockExclusive(&s_spuq_bind_lock);
+    for (int i = 0; i < 64; i++)
+        if (s_spuq_bind[i].tid == tid) memset(&s_spuq_bind[i], 0, sizeof(s_spuq_bind[i]));
+    ReleaseSRWLockExclusive(&s_spuq_bind_lock);
+}
+static int64_t sys_spu_thread_bind_queue(ppu_context* ctx)
+{
+    uint32_t tid = LV2_ARG_U32(ctx, 0), qid = LV2_ARG_U32(ctx, 1), spuq = LV2_ARG_U32(ctx, 2);
+    uint32_t result = CELL_OK;
+    if (!spu_find_thread(tid)) result = CELL_ESRCH;
+    else if (!sys_event_queue_is_spu(qid)) result = CELL_EINVAL;
+
+    int slot = -1;
+    if (result == CELL_OK) {
+        AcquireSRWLockExclusive(&s_spuq_bind_lock);
+        for (int i = 0; i < 64; i++) {
+            if (s_spuq_bind[i].qid && s_spuq_bind[i].tid == tid &&
+                (s_spuq_bind[i].spuq == spuq || s_spuq_bind[i].qid == qid)) {
+                result = CELL_EBUSY;
+                break;
+            }
+            if (slot < 0 && !s_spuq_bind[i].qid) slot = i;
+        }
+        if (result == CELL_OK && slot < 0) result = CELL_EAGAIN;
+        if (result == CELL_OK) {
+            s_spuq_bind[slot].tid = tid;
+            s_spuq_bind[slot].spuq = spuq;
+            s_spuq_bind[slot].qid = qid;
+        }
+        ReleaseSRWLockExclusive(&s_spuq_bind_lock);
+    }
+    if (result == CELL_OK)
+        fprintf(stderr, "[SPU] bind_queue tid=0x%X queue=%u spuq=0x%X\n", tid, qid, spuq);
+    ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)result;
+    return (int64_t)ctx->gpr[3];
+}
+
+static int64_t sys_spu_thread_unbind_queue(ppu_context* ctx)
+{
+    const uint32_t tid = LV2_ARG_U32(ctx, 0), spuq = LV2_ARG_U32(ctx, 1);
+    uint32_t result = CELL_ESRCH;
+    AcquireSRWLockExclusive(&s_spuq_bind_lock);
+    for (int i = 0; i < 64; i++) {
+        if (s_spuq_bind[i].qid && s_spuq_bind[i].tid == tid && s_spuq_bind[i].spuq == spuq) {
+            memset(&s_spuq_bind[i], 0, sizeof(s_spuq_bind[i]));
+            result = CELL_OK;
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_spuq_bind_lock);
+    ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)result;
+    return (int64_t)ctx->gpr[3];
+}
