+int sys_event_queue_is_spu(uint32_t queue_id)
+{
+    if (!queue_id || queue_id > SYS_EVENT_QUEUE_MAX) return 0;
+    evt_table_lock();
+    const sys_event_queue_info* q = &g_sys_event_queues[queue_id - 1];
+    const int ok = q->active && q->type == SYS_SPU_QUEUE;
+    evt_table_unlock();
+    return ok;
+}
+
+/* Host-side blocking receive for STOP 0x110. Use the same table -> queue lock
+ * order as create/destroy, so the queue cannot be reinitialized between
+ * validation and acquiring its lock. A 50 ms timed wait observes shutdown. */
+int sys_event_queue_receive_host(uint32_t queue_id, uint64_t out[3], volatile int* stop)
+{
+    if (!out || queue_id == 0 || queue_id > SYS_EVENT_QUEUE_MAX) return -1;
+    evt_table_lock();
+    sys_event_queue_info* q = &g_sys_event_queues[queue_id - 1];
+    if (!q->active || q->type != SYS_SPU_QUEUE) {
+        evt_table_unlock();
+        return -1;
+    }
+#ifdef _WIN32
+    EnterCriticalSection(&q->lock);
+#else
+    pthread_mutex_lock(&q->lock);
+#endif
+    evt_table_unlock();
+
+    q->waiters++;
+    while (!q->count && q->active && !q->cancelled && !(stop && *stop)) {
+#ifdef _WIN32
+        SleepConditionVariableCS(&q->not_empty, &q->lock, 50);
+#else
+        struct timespec deadline;
+        clock_gettime(CLOCK_REALTIME, &deadline);
+        deadline.tv_nsec += 50000000L;
+        if (deadline.tv_nsec >= 1000000000L) {
+            deadline.tv_sec++;
+            deadline.tv_nsec -= 1000000000L;
+        }
+        pthread_cond_timedwait(&q->not_empty, &q->lock, &deadline);
+#endif
+    }
+
+    const int ok = q->active && !q->cancelled && !(stop && *stop) && q->count > 0;
+    if (ok) {
+        const sys_event_t evt = q->buffer[q->head];
+        q->head = (q->head + 1) % q->capacity;
+        q->count--;
+        out[0] = evt.data1;
+        out[1] = evt.data2;
+        out[2] = evt.data3;
+    }
+    q->waiters--;
+#ifdef _WIN32
+    LeaveCriticalSection(&q->lock);
+#else
+    pthread_mutex_unlock(&q->lock);
+#endif
+    return ok ? 0 : -1;
+}
