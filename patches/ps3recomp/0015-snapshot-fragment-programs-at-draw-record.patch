From: inFAMOUS FoB Recomp contributors
Subject: [PATCH 0015] video: snapshot fragment instruction bytes before shader-ring reuse

Hash and decompile each draw from the same recorded bytes as its constants.
The guest can reuse an FP ring allocation before deferred D3D12 preparation.
No shader instructions or simulation work are replaced or skipped.

--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -92,6 +92,9 @@
     int is_vp;          /* 1 = real VP path: vb_byte_offset indexes vp_vb (float4) */
     /* VP path per-draw shader/texture state, captured at draw_arrays time. */
     u32 fp_addr;        /* SET_SHADER_PROGRAM value (guest FP ucode location)   */
+    /* Immutable instruction bytes: guest FP rings can be reused before preparation. */
+    u32 fp_ucode_size, fp_ucode_ea;
+    u8 fp_ucode[VP_FP_UCODE_BYTES];
     u32 fp_ctrl;        /* SET_SHADER_CONTROL export bits at draw time (FP_CTRL_BITS) */
     u32 alpha_ctl;      /* alpha test: enable<<16 | (func&0xFF)<<8 | ref */
     u32 begin_epoch;    /* SET_BEGIN_END generation, for batch concatenation */
@@ -2408,15 +2411,13 @@
     return mask;
 }
 
-static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, int nrt,
