                                           DXGI_FORMAT rtfmt, u32 ctrl, u32 cmask, u32 cull,
                                           u32 cube_mask, u32 unnorm_mask, const u32 unnorm_dim[16][3], u64 zs)
 {
     if (nrt < 0) nrt = 0; if (nrt > 4) nrt = 4;   /* 0: a depth-only pass */
     if (rtfmt == 0) rtfmt = DXGI_FORMAT_R8G8B8A8_UNORM;
-    extern uint8_t* vm_base;
-    extern u32 cellGcmResolveOffset(u32);
-    if (!fp_addr || !vm_base) return NULL;
+    if (!fp_addr || !ucode || !ucode_bytes) return NULL;
     { static int _off=-1; if(_off<0)_off=getenv("FP_OFF")?1:0; if(_off) return NULL; }
     /* Resolve the VS: the draw's cached per-VP blob, else the primary. */
     ID3DBlob* vsb = NULL; u32 vs_hash = 0;
@@ -2426,11 +2427,8 @@
     if (!vsb) { vsb = s_d3d.vp_vs_blob; vs_idx = -1; }
     if (!vsb) return NULL;
 
-    /* SET_SHADER_PROGRAM low bits = location+1 (same as textures): 1 = LOCAL
-     * (VRAM), 2 = MAIN (gcm/cube emits 0x00B90001 for its VRAM-resident FP). */
-    extern u32 cellGcmResolveLocated(int local, u32 offset);
-    u32 off = cellGcmResolveLocated((fp_addr & 0x3u) == 1, fp_addr & ~0x3u);
-    if (off == 0xFFFFFFFFu) return NULL;
+    /* The record owns these bytes. Resolving fp_addr here can read an entirely
+     * different program after a guest shader-ring allocation is reused. */
 
     static int consts_inline = -1;
     if (consts_inline < 0) {
@@ -2442,15 +2440,15 @@
      * values from the draw, so changing them does not require a new pipeline. */
     u32 uhash;
     {
-        u32 usz = rsx_fp_program_size(vm_base + off, VP_FP_UCODE_BYTES);
+        u32 usz = rsx_fp_program_size(ucode, ucode_bytes);
         if (usz == 0) usz = 64;
         s_perf_pso_hashbytes += (int)usz;
         if (!buffered) {
             uhash = 2166136261u;
-            const u8* up = vm_base + off;
+            const u8* up = ucode;
             for (u32 i = 0; i < usz; i++) { uhash ^= up[i]; uhash *= 16777619u; }
         } else {
-            uhash = rsx_fp_code_hash(vm_base + off, VP_FP_UCODE_BYTES);
+            uhash = rsx_fp_code_hash(ucode, ucode_bytes);
         }
     }
 
@@ -2547,7 +2545,7 @@
     int n;
     if (buffered) {
         u32 count = 0;
-        n = rsx_fp_decompile_buffered_ex(vm_base + off, VP_FP_UCODE_BYTES, fp_ctrl, 0,
+        n = rsx_fp_decompile_buffered_ex(ucode, ucode_bytes, fp_ctrl, 0,
                                         hlsl, sizeof(hlsl), &count);
         if (n > 0) {
             char decl[64], packed[96], alpha[96];
@@ -2560,7 +2558,7 @@
             hlsl_replace_all(hlsl, sizeof(hlsl), "float4 fp_alpha;", alpha);
