 {
-    return s_flip_request_count;
-}
+    return (u32)InterlockedCompareExchange(&s_flip_request_count, 0, 0);
+}
+#else
+static u32 s_flip_request_count = 0;
+static void gcm_count_flip_request(void)
+{
+    __atomic_fetch_add(&s_flip_request_count, 1u, __ATOMIC_RELAXED);
+}
+u32 cellGcm_flip_request_count(void)
+{
+    return __atomic_load_n(&s_flip_request_count, __ATOMIC_RELAXED);
+}
+#endif
