+ * counter carries no frame data, so relaxed ordering is sufficient. */
+#ifdef _WIN32
+static volatile LONG s_flip_request_count = 0;
+static void gcm_count_flip_request(void)
+{
+    InterlockedIncrement(&s_flip_request_count);
+}
