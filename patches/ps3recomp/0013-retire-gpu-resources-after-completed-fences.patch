-}
+    u64 target = ++s_d3d.fence_values[fi];
+    HRESULT hr = s_d3d.cmd_queue->lpVtbl->Signal(s_d3d.cmd_queue, s_d3d.fence, target);
+    if (FAILED(hr)) gpu_fence_sync_failed("queue Signal", hr);
+    wait_for_fence_value(target);
+}
+
+#define GRAVE_INITIAL 512
+static struct {
+    ID3D12Resource** items;
+    size_t count, capacity;
+} s_grave[FRAME_COUNT];
+static void defer_release(ID3D12Resource* r)
+{
+    if (!r) return;
+    const u32 fi = s_d3d.frame_index % FRAME_COUNT;
+    if (s_grave[fi].count == s_grave[fi].capacity) {
+        size_t capacity = s_grave[fi].capacity ? s_grave[fi].capacity * 2 : GRAVE_INITIAL;
+        if (capacity < s_grave[fi].capacity || capacity > (size_t)-1 / sizeof(ID3D12Resource*))
+            gpu_fence_sync_failed("retirement capacity overflow", (HRESULT)0x8007000Eu);
+        ID3D12Resource** grown = (ID3D12Resource**)realloc(s_grave[fi].items, capacity * sizeof(*grown));
+        if (!grown) gpu_fence_sync_failed("retirement allocation", (HRESULT)0x8007000Eu);
+        s_grave[fi].items = grown;
+        s_grave[fi].capacity = capacity;
+    }
+    s_grave[fi].items[s_grave[fi].count++] = r;
+}
+static void grave_flush(u32 fi)
+{
+    fi %= FRAME_COUNT;
+    for (size_t i = 0; i < s_grave[fi].count; i++)
+        s_grave[fi].items[i]->lpVtbl->Release(s_grave[fi].items[i]);
+    s_grave[fi].count = 0;
+}
+static void retirement_shutdown(void)
+{
+    wait_for_gpu();
+    for (u32 fi = 0; fi < FRAME_COUNT; fi++) {
+        grave_flush(fi);
+        free(s_grave[fi].items);
+        s_grave[fi].items = NULL;
+        s_grave[fi].capacity = 0;
+    }
+}
