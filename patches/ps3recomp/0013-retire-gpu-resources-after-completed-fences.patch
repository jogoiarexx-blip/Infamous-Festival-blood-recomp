From: inFAMOUS FoB Recomp contributors
Subject: [PATCH 0013] video: retire GPU resources safely after completed fence values

--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -1410,59 +1410,93 @@
  * Frame sync helpers
  * -----------------------------------------------------------------------*/
 
+static void gpu_fence_sync_failed(const char* operation, HRESULT reason)
+{
+    fprintf(stderr, "[D3D12] GPU synchronization failed (%s): 0x%08lX; stopping before reusing GPU resources\n",
+            operation, (long)reason);
+    fflush(stderr);
+    abort();
+}
+
+static void wait_for_fence_value(u64 target)
+{
+    for (int attempt = 0; attempt < 3; attempt++) {
+        u64 completed = s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence);
+        if (completed == ~(u64)0)
+            gpu_fence_sync_failed("removed fence", s_d3d.device->lpVtbl->GetDeviceRemovedReason(s_d3d.device));
+        if (completed >= target) return;
+        HRESULT hr = s_d3d.fence->lpVtbl->SetEventOnCompletion(s_d3d.fence, target, s_d3d.fence_event);
+        if (FAILED(hr)) gpu_fence_sync_failed("SetEventOnCompletion", hr);
+        DWORD result = WaitForSingleObject(s_d3d.fence_event, 2000);
+        completed = s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence);
+        if (completed != ~(u64)0 && completed >= target) return;
+        hr = s_d3d.device->lpVtbl->GetDeviceRemovedReason(s_d3d.device);
+        if (completed == ~(u64)0 || FAILED(hr)) gpu_fence_sync_failed("device removed", hr);
+        if (result != WAIT_TIMEOUT && result != WAIT_OBJECT_0)
+            gpu_fence_sync_failed("fence event wait", (HRESULT)0x80004005u);
+        fprintf(stderr, "[D3D12] fence incomplete after %ds: want %llu got %llu\n",
+                2 * (attempt + 1), (unsigned long long)target, (unsigned long long)completed);
+    }
+    gpu_fence_sync_failed("fence timeout", (HRESULT)0x800705B4u);
+}
+
