+static ID3DBlob* d3d12_compile_shader_cached(const char* src, size_t len, const char* name,
+                                             const char* entry, const char* target, ID3DBlob** out_err)
+{
+    if (out_err) *out_err = NULL;
+    if (!src || len == 0) return NULL;
+
+    /* Compute 64-bit FNV-1a hash of target + src */
+    uint64_t h = 14695981039346656037ULL;
+    for (const char* p = target; *p; p++) {
+        h ^= (uint8_t)*p;
+        h *= 1099511628211ULL;
+    }
+    for (size_t i = 0; i < len; i++) {
+        h ^= (uint8_t)src[i];
+        h *= 1099511628211ULL;
+    }
+
+    const char* cdir = getenv("RSX_SHADER_CACHE_DIR");
+    if (!cdir || !*cdir) cdir = "shader_cache";
+
+    static int dir_created = 0;
+    if (!dir_created) {
+        CreateDirectoryA(cdir, NULL);
+        dir_created = 1;
+    }
+
+    char filepath[MAX_PATH];
+    snprintf(filepath, sizeof(filepath), "%s/%s_%016llX.bin", cdir, target, (unsigned long long)h);
+
+    /* Try loading cached bytecode from disk */
+    HANDLE hFile = CreateFileA(filepath, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (hFile != INVALID_HANDLE_VALUE) {
+        DWORD sz = GetFileSize(hFile, NULL);
+        if (sz > 0 && sz < 10 * 1024 * 1024) {
+            ID3DBlob* blob = NULL;
+            if (SUCCEEDED(D3DCreateBlob(sz, &blob)) && blob) {
+                DWORD read = 0;
+                if (ReadFile(hFile, blob->lpVtbl->GetBufferPointer(blob), sz, &read, NULL) && read == sz) {
+                    CloseHandle(hFile);
+                    return blob;
+                }
+                blob->lpVtbl->Release(blob);
+            }
+        }
+        CloseHandle(hFile);
+    }
+
+    /* Fallback: compile with D3DCompile */
+    ID3DBlob* blob = NULL;
+    ID3DBlob* err = NULL;
+    HRESULT hr = D3DCompile(src, len, name, NULL, NULL, entry, target, 0, 0, &blob, &err);
+    if (out_err) *out_err = err;
+    else if (err) err->lpVtbl->Release(err);
+
+    if (SUCCEEDED(hr) && blob) {
+        HANDLE hOut = CreateFileA(filepath, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (hOut != INVALID_HANDLE_VALUE) {
+            DWORD written = 0;
+            WriteFile(hOut, blob->lpVtbl->GetBufferPointer(blob), (DWORD)blob->lpVtbl->GetBufferSize(blob), &written, NULL);
+            CloseHandle(hOut);
+        }
+        return blob;
+    }
+    return NULL;
+}
